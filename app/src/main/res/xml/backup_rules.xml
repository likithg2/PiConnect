<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for API 30 and below.
    Excludes all shared preferences and databases that may contain
    sensitive connection state (device IPs, paired device info, etc.).
    See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Exclude all shared preferences – may contain device/network state -->
    <exclude domain="sharedpref" path="." />
    <!-- Exclude all databases – may contain transfer history / credentials -->
    <exclude domain="database" path="." />
    <!-- Exclude the app's internal files directory -->
    <exclude domain="file" path="." />
    <!-- Exclude external files -->
    <exclude domain="external" path="." />
</full-backup-content>