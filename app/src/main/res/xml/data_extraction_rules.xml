<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for API 31+.
    Excludes all shared preferences and databases from both cloud backup
    and device-to-device transfer to avoid leaking connection state.
    See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all shared preferences – may contain device/network state -->
        <exclude domain="sharedpref" path="." />
        <!-- Exclude all databases – may contain transfer history / credentials -->
        <exclude domain="database" path="." />
        <!-- Exclude internal files -->
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude sensitive prefs and databases from device-to-device transfer -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>